    CMJUCHU_JUCHU_DATE CHAR(6)    NOT NULL,
    CMJUCHU_SHOHIN_NO  CHAR(5)    NOT NULL,
    CMJUCHU_SURYO      NUMERIC(5) NOT NULL
);

